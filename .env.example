# Copy this file to .env and fill in your keys. .env is git-ignored.
# One KEY=VALUE per line. Only the providers you actually use are required.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional: enable LangSmith tracing later (no code changes needed).
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=ls__...
# LANGSMITH_PROJECT=sql-agent-eval
